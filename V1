-- ═══════════ CHAT COMMANDS ═══════════
local started = false

local function startCrash()
    if started then return end
    started = true
    pcall(api.start)
    dot.BackgroundColor3 = C.good
    status.TextColor3 = C.good
end

local function stopCrash()
    if not started then return end
    started = false
    pcall(api.stop)
    dot.BackgroundColor3 = C.textDim
    status.Text = "IDLE — type !start in chat"
    status.TextColor3 = C.textDim
end

-- Path 1: Player.Chatted (fires for local player in most games)
pcall(function()
    player.Chatted:Connect(function(msg)
        local m = tostring(msg):lower():gsub("^%s+", ""):gsub("%s+$", "")
        if m == "!start" then startCrash()
        elseif m == "!stop" then stopCrash() end
    end)
end)

-- Path 2: TextChatService.MessageReceived (modern chat)
pcall(function()
    TextChatService.MessageReceived:Connect(function(message)
        if not message.TextSource then return end
        if message.TextSource.UserId ~= player.UserId then return end
        local m = tostring(message.Text or ""):lower():gsub("^%s+", ""):gsub("%s+$", "")
        if m == "!start" then startCrash()
        elseif m == "!stop" then stopCrash() end
    end)
end)

-- ═══════════ LIVE READOUT ═══════════
local lastPasses, lastT, acc = 0, os.clock(), 0

RunService.RenderStepped:Connect(function(dt)
    acc += dt
    if acc < 0.25 then return end
    acc = 0

    local _, passes, _, children, queued, reason, _, interval = api.stats()

    payloadVal.Text  = string.format("%s", tostring(children))
    passesVal.Text   = tostring(passes)
    queueVal.Text    = string.format("%.1f MB", queued or 0)
    intervalVal.Text = string.format("%.2fs", interval or 0)

    if reason ~= "" and reason ~= "at floor" then
        remoteVal.Text = reason
        remoteVal.TextColor3 = C.warn
    elseif started then
        remoteVal.Text = "active"
        remoteVal.TextColor3 = C.good
    else
        remoteVal.Text = "idle"
        remoteVal.TextColor3 = C.textDim
    end

    if started then
        local now = os.clock()
        local rate = (passes - lastPasses) / math.max(now - lastT, 1e-3)
        lastPasses, lastT = passes, now
        status.Text = string.format("RUNNING · %.1f/s · %s", rate, reason ~= "" and reason or "ok")
        status.TextColor3 = (reason ~= "" and reason ~= "at floor") and C.warn or C.good
    end
end)

-- ═══════════ DRAG ═══════════
local dragging, dragStart, startPos = false, nil, nil

header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = main.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not dragging then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then
        local d = input.Position - dragStart
        main.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + d.X,
            startPos.Y.Scale, startPos.Y.Offset + d.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

closeBtn.MouseButton1Click:Connect(function()
    gui.Enabled = false
end)

-- Resolve remote name for display
task.spawn(function()
    task.wait(0.2)
    local r = game:FindFirstChild("RobloxReplicatedStorage")
        or game:FindFirstChild("ReplicatedStorage")
    if r then
        r = r:FindFirstChild("SetPlayerBlockList")
        if r then
            remoteVal.Text = r.Name
            remoteVal.TextColor3 = C.good
            return
        end
    end
    remoteVal.Text = "not found"
    remoteVal.TextColor3 = C.warn
end)
